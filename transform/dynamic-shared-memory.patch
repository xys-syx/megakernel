+/// A block may keep at most 48 KiB of static shared memory; beyond that, CUDA only offers
+/// dynamic shared memory, which the kernel must opt in to before it is launched. For a kernel
+/// whose block-scope arrays exceed that limit, place them all in one `extern __shared__` region,
+/// pass the region's size on every launch of the kernel, and opt the kernel in once at the start
+/// of each host function that launches it. Kernels within the limit are left to
+/// SharedMemrefAllocaToGlobal, unchanged.
+static void moveLargeSharedArraysToDynamic(Operation *root, StringRef backend) {
+  if (backend != "cuda")
+    return;
+  constexpr int64_t staticSharedLimit = 48 * 1024;
+  auto module = dyn_cast<ModuleOp>(root);
+  if (!module)
+    module = root->getParentOfType<ModuleOp>();
+  if (!module)
+    return;
+  MLIRContext *ctx = root->getContext();
+  DataLayout layout(module);
+  SmallVector<gpu::GPUFuncOp> kernels;
+  root->walk([&](gpu::GPUFuncOp f) {
+    if (f.isKernel())
+      kernels.push_back(f);
+  });
+  SmallVector<gpu::LaunchFuncOp> launches;
+  root->walk([&](gpu::LaunchFuncOp l) { launches.push_back(l); });
+
+  for (gpu::GPUFuncOp kernel : kernels) {
+    SmallVector<memref::AllocaOp> arrays;
+    bool unsupported = false;
+    kernel.walk([&](Operation *op) {
+      if (auto a = dyn_cast<memref::AllocaOp>(op)) {
+        if (a.getType().getMemorySpaceAsInt() != 5)
+          return;
+        if (a.getType().hasStaticShape())
+          arrays.push_back(a);
+        else
+          unsupported = true;
+      } else if (auto a = dyn_cast<LLVM::AllocaOp>(op)) {
+        if (cast<LLVM::LLVMPointerType>(a.getType()).getAddressSpace() == 5)
+          unsupported = true;
+      }
+    });
+    if (arrays.empty() || unsupported)
+      continue;
+    SmallVector<int64_t> offsets;
+    int64_t bytes = 0;
+    for (memref::AllocaOp a : arrays) {
+      bytes = llvm::alignTo(bytes, 16);
+      offsets.push_back(bytes);
+      bytes += a.getType().getNumElements() *
+               layout.getTypeSize(a.getType().getElementType());
+    }
+    if (bytes <= staticSharedLimit)
+      continue;
+
+    // The region, and each array a view of it.
+    auto gpuModule = kernel->getParentOfType<gpu::GPUModuleOp>();
+    OpBuilder b(ctx);
+    b.setInsertionPointToStart(gpuModule.getBody());
+    auto region = LLVM::GlobalOp::create(
+        b, kernel.getLoc(), LLVM::LLVMArrayType::get(b.getI8Type(), 0),
+        /*isConstant=*/false, LLVM::Linkage::External,
+        (kernel.getName() + "_dynamic_shared_memory").str(), Attribute(),
+        /*alignment=*/16, /*addrSpace=*/3);
+    auto sharedPtr = LLVM::LLVMPointerType::get(ctx, 3);
+    for (auto [a, offset] : llvm::zip(arrays, offsets)) {
+      b.setInsertionPoint(a);
+      Value base = LLVM::AddressOfOp::create(b, a.getLoc(), region);
+      Value ptr =
+          LLVM::GEPOp::create(b, a.getLoc(), sharedPtr, b.getI8Type(), base,
+                              ArrayRef<LLVM::GEPArg>{(int32_t)offset});
+      auto type = MemRefType::get(a.getType().getShape(),
+                                  a.getType().getElementType(), {},
+                                  /* memspace */ 3);
+      Value view =
+          enzymexla::Pointer2MemrefOp::create(b, a.getLoc(), type, ptr);
+      a.getResult().replaceAllUsesWith(view);
+      a.erase();
+    }
+    kernel->setAttr("reactant.dynamic_shared_memory_bytes",
+                    b.getI64IntegerAttr(bytes));
+
+    // Every launch passes the size; each host function launching the kernel opts it in once.
+    Type i32 = b.getI32Type();
+    auto hostPtr = LLVM::LLVMPointerType::get(ctx);
+    llvm::SmallPtrSet<Operation *, 4> optedIn;
+    for (gpu::LaunchFuncOp launch : launches) {
+      if (launch.getKernelModuleName().getValue() != gpuModule.getName() ||
+          launch.getKernelName().getValue() != kernel.getName())
+        continue;
+      b.setInsertionPoint(launch);
+      Value size = arith::ConstantIntOp::create(b, launch.getLoc(), bytes, 32);
+      launch.getDynamicSharedMemorySizeMutable().assign(size);
+      auto host = launch->getParentOfType<FunctionOpInterface>();
+      if (!host || host.getFunctionBody().empty() ||
+          !optedIn.insert(host.getOperation()).second)
+        continue;
+      FailureOr<LLVM::LLVMFuncOp> setAttribute = LLVM::lookupOrCreateFn(
+          b, module, "cudaFuncSetAttribute", {hostPtr, i32, i32}, i32);
+      if (failed(setAttribute)) {
+        launch->emitWarning("cannot declare cudaFuncSetAttribute; the launch "
+                            "of a kernel with ")
+            << bytes << " bytes of dynamic shared memory may fail";
+        continue;
+      }
+      b.setInsertionPointToStart(&host.getFunctionBody().front());
+      Value address = enzymexla::GPUKernelAddressOp::create(
+          b, launch.getLoc(), hostPtr, launch.getKernel());
+      // cudaFuncAttributeMaxDynamicSharedMemorySize
+      Value attribute = arith::ConstantIntOp::create(b, launch.getLoc(), 8, 32);
+      Value limit = arith::ConstantIntOp::create(b, launch.getLoc(), bytes, 32);
+      LLVM::CallOp::create(b, launch.getLoc(), *setAttribute,
+                           ValueRange{address, attribute, limit});
+    }
+  }
+}
